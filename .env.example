# Expense Tracker — Environment Variables
# Copy this file to .env (production) and .env.local (staging/dev)
# Fill in the values for your environment. Never commit .env or .env.local.

# ─────────────────────────────────────────────
# Firebase (Next.js client — all NEXT_PUBLIC_)
# Get these from Firebase Console > Project Settings > Your apps > Web app
# ─────────────────────────────────────────────

# Firebase API key (identifies your Firebase project)
NEXT_PUBLIC_FIREBASE_API_KEY=

# Firebase Auth domain (e.g., your-project-id.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Firebase project ID (e.g., your-project-id)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Storage bucket (e.g., your-project-id.appspot.com)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Messaging sender ID (numeric, e.g., 123456789012)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase App ID (e.g., 1:123456789012:web:abc123def456)
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────
# Authorized users (Next.js client — all NEXT_PUBLIC_)
# The Google account email for each household member. Sign-in only succeeds for
# an email listed here; anything else is rejected as unauthorized.
# These are baked into the client bundle at build time — set them in app/.env.local
# (production) and app/.env.staging (staging), not just here.
# ─────────────────────────────────────────────

# Email for user1 ("ijac")
NEXT_PUBLIC_USER1_EMAIL=

# Email for user2 ("wei")
NEXT_PUBLIC_USER2_EMAIL=

# ─────────────────────────────────────────────
# Google Sheets (Firebase Functions — server only, never expose to client)
# See SETUP.md for how to create the service account and Spreadsheet
# ─────────────────────────────────────────────

# Google Spreadsheet ID — the long string in the Spreadsheet URL
# (e.g., https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit)
GOOGLE_SPREADSHEET_ID=

# Google service account email (e.g., expense-tracker@your-project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Google service account private key — the full JSON key value including BEGIN/END markers
# In .env files, wrap in double quotes and replace literal newlines with \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ─────────────────────────────────────────────
# API authorization (Firebase Functions — server only)
# ─────────────────────────────────────────────

# Comma-separated Google account emails the API will answer for. Every request
# must present a Firebase ID token whose verified email is in this list; anything
# else is rejected (401 for no/bad token, 403 for a valid token we do not allow).
#
# This is a SERVER-side variable and must be set in functions/.env (production)
# and functions/.env.staging (staging) — the NEXT_PUBLIC_ vars above are Next.js
# build-time values the Functions runtime cannot read.
#
# The same two addresses as NEXT_PUBLIC_USER1_EMAIL / NEXT_PUBLIC_USER2_EMAIL.
# Leaving it unset fails closed: every API request returns 500 rather than
# silently allowing everyone through. Verify the two sides agree before any
# deploy with: npm --prefix functions run check:auth-emails
AUTHORIZED_EMAILS=

{
  "name": "expense-sheet-functions",
  "version": "1.0.0",
  "description": "Firebase Functions for Expense Tracker",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "prepare": "test -f ../scripts/install-hooks.js && node ../scripts/install-hooks.js || true",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && node --test test/",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate:insurance-tax": "node -r ./scripts/load-local-env.js scripts/apply-insurance-tax-categories.js",
    "migrate:insurance-tax:dry-run": "node -r ./scripts/load-local-env.js scripts/apply-insurance-tax-categories.js --dry-run",
    "backfill:analyze": "npm run build && node -r ./scripts/load-local-env.js scripts/backfill-subscription-history.js --analyze",
    "backfill:apply:dry-run": "npm run build && node -r ./scripts/load-local-env.js scripts/backfill-subscription-history.js --apply --dry-run",
    "backfill:apply": "npm run build && node -r ./scripts/load-local-env.js scripts/backfill-subscription-history.js --apply",
    "migrate:category-ids:dry-run": "npm run build && npm --prefix ../app run build:lib && node -r ./scripts/load-local-env.js scripts/normalize-category-ids.js --dry-run",
    "migrate:category-ids": "npm run build && npm --prefix ../app run build:lib && node -r ./scripts/load-local-env.js scripts/normalize-category-ids.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "googleapis": "^171.4.0",
    "undici-types": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "private": true
}
